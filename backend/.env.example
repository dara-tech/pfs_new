# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=psf_db
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-in-production

# Client URL (primary frontend origin for CORS)
CLIENT_URL=http://localhost:5173

# Extra CORS origins (comma-separated), e.g. https://psf-flax.vercel.app
# CORS_ORIGINS=https://psf-flax.vercel.app,https://psfnew.nchads.gov.kh

# Scaling (production)
DB_POOL_MAX=50
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# Redis reporting cache (local: brew install redis && brew services start redis)
REDIS_URL=redis://127.0.0.1:6379
REPORTING_CACHE_DASHBOARD_TTL=60
REPORTING_CACHE_TABLE_TTL=120

# PM2 cluster (production only)
# PM2_INSTANCES=4
