# Vercel production (custom domain psfnew.nchads.gov.kh)
# Leave API vars unset — vercel.json proxies /api to the VPS API host.
VITE_USE_PHP_GATEWAY=false

# Optional: call API directly (skip Vercel /api rewrite). Requires backend CORS.
# VITE_API_BASE=https://api.psfnew.nchads.gov.kh

# HostPapa static deploy only (deploy/hostpapa/deploy-frontend.sh sets this):
# VITE_USE_PHP_GATEWAY=true
