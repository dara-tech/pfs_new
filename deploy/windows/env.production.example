# PSF API — copy to C:\psf-api\.env (never commit)

PORT=3000
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=psfnew
DB_USERNAME=root
DB_PASSWORD=REPLACE_XAMPP_MYSQL_ROOT_PASSWORD

JWT_SECRET=REPLACE_LONG_RANDOM_STRING
JWT_EXPIRES_IN=24h
SESSION_SECRET=REPLACE_ANOTHER_RANDOM_STRING

CLIENT_URL=https://psfnew.nchads.gov.kh
CORS_ORIGINS=https://psf-flax.vercel.app,https://psfnew.nchads.gov.kh

DB_POOL_MAX=50
DB_POOL_MIN=2

# Optional — install Redis/Memurai on Windows first
# REDIS_URL=redis://127.0.0.1:6379
# REPORTING_CACHE_DASHBOARD_TTL=60
# REPORTING_CACHE_TABLE_TTL=120

PM2_INSTANCES=2
