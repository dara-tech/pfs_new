# Copy to backend/.env on HostPapa (Node app folder). Do not commit real secrets.

NODE_ENV=production
PORT=3000
# Use the port cPanel assigns to your Node.js app

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_CPANEL_DB_NAME
DB_USERNAME=YOUR_CPANEL_DB_USER
DB_PASSWORD=YOUR_CPANEL_DB_PASSWORD

JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=24h
SESSION_SECRET=change-me-long-random-string

CLIENT_URL=https://psfnew.nchads.gov.kh
